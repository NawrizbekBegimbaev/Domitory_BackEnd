{
	"info": {
		"name": "Dormitory API v1",
		"description": "Full API collection for Dormitory Management System.\n\n**Setup:**\n1. Run \"Auth / Login\" first — tokens auto-save to variables\n2. All other requests use Bearer token automatically\n\n**Default credentials:**\n- Email: admin@dormitory.uz\n- Password: admin123456",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{"key": "base_url", "value": "http://127.0.0.1:8000/api/v1"},
		{"key": "access_token", "value": ""},
		{"key": "refresh_token", "value": ""},
		{"key": "org_id", "value": ""},
		{"key": "building_id", "value": ""},
		{"key": "floor_id", "value": ""},
		{"key": "room_id", "value": ""},
		{"key": "room2_id", "value": ""},
		{"key": "resident_id", "value": ""},
		{"key": "contract_id", "value": ""},
		{"key": "assignment_id", "value": ""},
		{"key": "tariff_id", "value": ""},
		{"key": "charge_id", "value": ""},
		{"key": "payment_id", "value": ""},
		{"key": "user_id", "value": ""}
	],
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{access_token}}"}]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access) {",
									"    pm.collectionVariables.set('access_token', json.access);",
									"    pm.collectionVariables.set('refresh_token', json.refresh);",
									"    pm.collectionVariables.set('user_id', json.user_id);",
									"    pm.test('Login successful', function() { pm.response.to.have.status(200); });",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"url": "{{base_url}}/auth/login/",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@dormitory.uz\",\n    \"password\": \"admin123456\"\n}"
						}
					}
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var json = pm.response.json();",
									"if (json.access) {",
									"    pm.collectionVariables.set('access_token', json.access);",
									"    if (json.refresh) pm.collectionVariables.set('refresh_token', json.refresh);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"url": "{{base_url}}/auth/refresh/",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"{{refresh_token}}\"\n}"
						}
					}
				},
				{
					"name": "Me (current user)",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/auth/me/"
					}
				}
			]
		},
